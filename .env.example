# Local development only. Copy to .env (git-ignored). Do not put real secrets here.
# Existing environment variables win over this file.
DATABASE_URL=postgres://payment:local-dev-only@127.0.0.1:5432/payment_dev?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
PAYMENT_MODE=test
# HTTP_ADDR=:8080
# METRICS_ADDR=:8081
# SHUTDOWN_TIMEOUT=10s
# LOG_LEVEL=info
# Uncomment to send traces to the local collector from `make up-observability`.
# Spans still exist, and logs still carry trace_id, when this is unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=127.0.0.1:4317
